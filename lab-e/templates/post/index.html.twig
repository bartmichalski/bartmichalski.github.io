{% extends 'base.html.twig' %}

{% block title %}Post index{% endblock %}

{% block body %}
    <h1 class="mb-4">Post index</h1>

    <div class="table-responsive shadow-sm bg-white rounded">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Subject</th>
                <th>Description</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for post in posts %}
                <tr>
                    <td class="align-middle">{{ post.id }}</td>
                    <td class="align-middle">{{ post.subject }}</td>
                    <td class="align-middle">{{ post.description }}</td>
                    <td class="text-end align-middle">
                        <div class="btn-group" role="group">
                            <a href="{{ path('app_post_show', {'id': post.id}) }}" class="btn btn-sm btn-info text-white">show</a>
                            <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-warning">edit</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_post_new') }}" class="btn btn-success mt-3">Create new</a>
{% endblock %}
